{
  "page_objects": [
    {
      "id": "page_login",
      "name": "LoginPage",
      "selectors": [
        {
          "element": "username_field",
          "selector": "#username"
        },
        {
          "element": "password_field",
          "selector": "#password"
        },
        {
          "element": "login_button",
          "selector": "button[type='submit']"
        }
      ]
    }
  ],
  "test_flows": [
    {
      "id": "flow_login",
      "name": "LoginFlow",
      "steps": [
        {
          "action": "fill",
          "target": "username_field",
          "value": "{username}"
        },
        {
          "action": "fill",
          "target": "password_field",
          "value": "{password}"
        },
        {
          "action": "click",
          "target": "login_button"
        }
      ]
    }
  ],
  "test_data": [
    {
      "id": "data_login",
      "dataset": {
        "username": "tomsmith",
        "password": "SuperSecretPassword!"
      }
    }
  ],
  "test_patterns": {
    "decorators": {
      "required": [
        "@screenshot_on_failure",
        "@pytest.mark.asyncio"
      ],
      "markers": [
        "@pytest.mark.login",
        "@pytest.mark.smoke", 
        "@pytest.mark.regression",
        "@pytest.mark.visual",
        "@pytest.mark.security"
      ]
    },
    "imports": [
      "import pytest",
      "from utils.decorators.screenshot_decorator import screenshot_on_failure"
    ],
    "function_signature": "async def test_function_name(app):",
    "page_access": "app.login_page.page",
    "navigation": "await app.login_page.navigate()"
  }
}
